{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "resolveJsonModule": true,
        "strict": true,
        "noEmit": true,
        "allowJs": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "lib": [
            "ESNext",
            "DOM"
        ]
    },
    "include": [
        "env.d.ts",
        ".vitepress/**/*.ts",
        ".vitepress/**/*.mts",
        ".vitepress/**/*.vue"
    ]
}
