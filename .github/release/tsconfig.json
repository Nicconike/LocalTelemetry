{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "types": [
            "node"
        ],
        "noEmit": true
    },
    "include": [
        "*.ts",
        "*.mjs"
    ],
    "exclude": [
        "node_modules"
    ]
}
