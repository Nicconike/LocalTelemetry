<Window
    x:Class="LocalTelemetry.App.Settings.SettingsShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    Title="LocalTelemetry"
    Width="740"
    Height="600"
    MinWidth="580"
    MinHeight="460"
    AllowsTransparency="False"
    Background="#1C1B19"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="36"
            CornerRadius="8"
            GlassFrameThickness="0"
            ResizeBorderThickness="10"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="TitleBarBg" Color="#1C1B19" />
        <SolidColorBrush x:Key="TitleFg" Color="#CDCCCA" />
        <SolidColorBrush x:Key="CloseHoverBg" Color="#A12C7B" />
        <SolidColorBrush x:Key="BtnHoverBg" Color="#2D2C2A" />
    </Window.Resources>

    <Grid Background="#171614">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ══ Custom title bar ══════════════════════════════════════════  -->
        <Grid
            Grid.Row="0"
            Background="{StaticResource TitleBarBg}"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Window title  -->
            <StackPanel
                Grid.Column="0"
                Margin="10,0,0,0"
                Orientation="Horizontal">
                <Viewbox
                    Width="16"
                    Height="16"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center">
                    <Grid Width="24" Height="24">
                        <Path
                            Data="M11.5 3H5.5C4.12 3 3 4.12 3 5.5V9.5"
                            Stroke="{StaticResource TitleFg}"
                            StrokeLineJoin="Round"
                            StrokeThickness="2" />
                        <Path
                            Data="M3 14.5V18.5C3 19.88 4.12 21 5.5 21H11.5"
                            Stroke="{StaticResource TitleFg}"
                            StrokeLineJoin="Round"
                            StrokeThickness="2" />
                        <Path
                            Data="M12.5 3H18.5C19.88 3 21 4.12 21 5.5V7"
                            Stroke="{StaticResource TitleFg}"
                            StrokeLineJoin="Round"
                            StrokeThickness="2" />
                        <Path Data="M12.5 20H18.5C19.33 20 20 19.33 20 18.5V13.844L22 12.5V18.5C22 20.43 20.43 22 18.5 22H12.5V20Z" Fill="{StaticResource TitleFg}" />
                        <Path
                            Data="M1 12H5.7619L7.19048 9.2L8.61905 13.6L10.5238 6L12.4286 18L14.3333 13.2H16.2381L21 10"
                            Stroke="{StaticResource TitleFg}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="2" />
                        <Path Data="M24 7.5L19 8.5L22 12L24 7.5Z" Fill="{StaticResource TitleFg}" />
                    </Grid>
                </Viewbox>
                <TextBlock
                    x:Name="WindowTitleText"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI Variable Text"
                    FontSize="13"
                    Foreground="{StaticResource TitleFg}"
                    Text="LocalTelemetry" />
            </StackPanel>

            <!--  Caption buttons  -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">

                <!--  Close / hide  -->
                <Button
                    Width="46"
                    Height="32"
                    BorderThickness="0"
                    Click="CloseButton_Click"
                    ToolTip="Close"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="{StaticResource CloseHoverBg}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <!--  U+2715 MULTIPLICATION X (close glyph)  -->
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource TitleFg}"
                        Text="&#x2715;" />
                </Button>

            </StackPanel>
        </Grid>

        <!--  WebView2 host  -->
        <wv2:WebView2
            x:Name="WebView"
            Grid.Row="1"
            Margin="10,0,10,10" />
    </Grid>
</Window>
